{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${credits}"
  ],
  "contact": {
    "sources": "${sources}",
    "issues": "${issues}",
    "homepage": "https://fishstiz.github.io/minecraft-cursor-wiki/"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.fishstiz.minecraftcursor.MinecraftCursorFabric"
    ],
    "modmenu": [
      "io.github.fishstiz.minecraftcursor.impl.MinecraftCursorModMenuApiImpl"
    ],
    "minecraft-cursor": [
      "io.github.fishstiz.minecraftcursor.impl.MinecraftCursorFabricInitializer"
    ]
  },
  "mixins": [
    {
      "config": "${mod_id}.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range_semver}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "accessWidener": "${mod_id}.accesswidener",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.wiki": "https://fishstiz.github.io/minecraft-cursor-wiki/"
      }
    }
  }
}